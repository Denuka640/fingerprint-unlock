<Window x:Class="BiometricUnlock.SetupApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biometric Phone Unlock - Setup &amp; Security" Height="720" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,24" Padding="0,0,0,16" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource AccentPrimary}" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">
                    <TextBlock Text="🛡️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Bluetooth Biometric Unlock" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Pair your phone's fingerprint sensor to unlock this PC securely" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content (2 Columns) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Windows Credentials & Security Settings -->
            <Border Grid.Column="0" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Windows Unlock Credentials" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="Credentials are encrypted via Windows DPAPI and never leave your machine." FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="Domain / Machine Name" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDomain" Margin="0,0,0,12"/>

                    <TextBlock Text="Windows Username" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUsername" Margin="0,0,0,12"/>

                    <TextBlock Text="Windows Password / PIN" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtPassword" Margin="0,0,0,16"/>

                    <Button x:Name="BtnSaveCreds" Content="Save to Secure DPAPI Vault" Background="{StaticResource AccentPrimary}" Foreground="White" FontWeight="SemiBold" Height="40" Click="BtnSaveCreds_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock x:Name="TxtCredsStatus" Foreground="{StaticResource AccentSuccess}" FontSize="12" Margin="0,8,0,16" TextAlignment="Center"/>

                    <Separator Background="{StaticResource CardBorder}" Margin="0,8,0,16"/>

                    <TextBlock Text="Bluetooth Proximity Filter (RSSI)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Rejects unlock if phone is farther than threshold signal strength" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Sensitivity: " Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock x:Name="TxtRssiValue" Text="-80 dBm" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                    </DockPanel>
                    <Slider x:Name="SliderRssi" Minimum="-95" Maximum="-50" Value="-80" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderRssi_ValueChanged"/>

                    <Button x:Name="BtnTestUnlock" Content="⚡ Test Lock Screen Pipe Trigger" Background="#334155" Foreground="White" Height="36" Margin="0,20,0,0" Click="BtnTestUnlock_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right Column: Mobile Pairing & Paired Devices -->
            <Border Grid.Column="2" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Pair Mobile Device" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Scan this QR code with the Biometric Unlock mobile app:" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- QR Code Display -->
                    <Border Grid.Row="1" Background="White" Width="180" Height="180" CornerRadius="10" HorizontalAlignment="Center" Margin="0,0,0,16" Padding="8">
                        <Image x:Name="ImgQrCode" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <!-- Paired Devices List -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Paired Phone Devices" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                        
                        <ListBox x:Name="ListPairedDevices" Grid.Row="1" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Foreground="{StaticResource TextPrimary}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <TextBlock Text="{Binding DeviceId}" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Remove" Tag="{Binding DeviceId}" Click="BtnRemoveDevice_Click" Background="#EF4444" Foreground="White" Padding="8,4" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Status Bar -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="12" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <TextBlock Text="Service Status: " Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                <TextBlock x:Name="TxtServiceStatus" Text="Ready &amp; Listening" Foreground="{StaticResource AccentSuccess}" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Text="Lock screen: Win + L to test" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
