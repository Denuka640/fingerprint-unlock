<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="24dp">

    <!-- Header / Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fingerprint PC Unlock"
        android:textColor="#F8FAFC"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secure Biometric Laptop Unlock"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/txtPairedPc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paired: Not paired yet (Scan QR)"
        android:textColor="#60A5FA"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="6dp" />

    <!-- Status Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1AFFFFFF"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtPairedPc">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <!-- Biometric Fingerprint Graphic -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="#60A5FA"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scanning for PC..."
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAlignment="center" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signal Strength: "
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtRssi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- dBm"
                    android:textColor="#34D399"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Unlock Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnlock"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Touch Fingerprint to Unlock"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        app:backgroundTint="#3B82F6"
        app:cornerRadius="16dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/cardStatus" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnUnlock">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Reconnect"
            android:textColor="#F8FAFC"
            app:backgroundTint="#1AFFFFFF"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPair"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Pair PC"
            android:textColor="#F8FAFC"
            app:backgroundTint="#1AFFFFFF"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtCopyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Designed by Denuka"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
